{
  "name": "@twitch-golf/ebs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Extension Backend Service: authoritative game state, round scheduler, JWT auth, broadcast.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./clock": "./src/clock.ts",
    "./config": "./src/config.ts",
    "./courses": "./src/courses.ts",
    "./game/game": "./src/game/game.ts",
    "./game/manager": "./src/game/manager.ts",
    "./http/server": "./src/http/server.ts",
    "./twitch/jwt": "./src/twitch/jwt.ts",
    "./twitch/pubsub": "./src/twitch/pubsub.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@twitch-golf/shared": "*",
    "fastify": "^5.2.0",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2"
  }
}
