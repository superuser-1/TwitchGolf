{
  "name": "@twitch-golf/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic golf sim, data model, chat-command grammar and course schema shared by the EBS and the extension frontend.",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./physics": "./src/physics/index.ts",
    "./geom": "./src/geom/index.ts",
    "./protocol": "./src/protocol/index.ts",
    "./model": "./src/model/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "zod": "^3.24.1"
  }
}
